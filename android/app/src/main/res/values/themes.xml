<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Minecraft3D" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/sky</item>
        <item name="android:statusBarColor">@color/sky</item>
        <item name="android:navigationBarColor">@color/sky</item>
    </style>
    <style name="Theme.Minecraft3D.NoActionBar" parent="Theme.Minecraft3D">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:fitsSystemWindows">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
